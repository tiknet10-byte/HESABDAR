# Copy to backend/.env. In local mode everything is optional (secrets are generated in data/).
HESABDAR_ENVIRONMENT=local
# HESABDAR_DATABASE_URL=postgresql+psycopg://user:pass@localhost/hesabdar
# HESABDAR_SECRET_KEY=
# HESABDAR_BACKUP_KEY=
# HESABDAR_WEBHOOK_SECRET=
# HESABDAR_BACKUP_INTERVAL_HOURS=6
# HESABDAR_BACKUP_KEEP=60
# ANTHROPIC_API_KEY=sk-ant-...      enables the AI assistant, receipt & sales-book vision
# HESABDAR_AI_MODEL=claude-opus-5-5
